generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  phone        String
  passwordHash String
  role          UserRole  @default(CLIENT)
  emailVerified Boolean   @default(false)
  emailVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  bookings      Booking[]
  reviews       Review[]
  resetTokens   PasswordResetToken[]
  verificationTokens EmailVerificationToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("email_verification_tokens")
}

model Service {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  category        ServiceCategory
  description     String
  duration        Int
  price           Int
  discountedPrice Int?
  image           String
  popular         Boolean         @default(false)
  forGender       Gender          @default(UNISEX)
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  bookings        Booking[]

  @@map("services")
}

model Stylist {
  id           String                @id @default(cuid())
  name         String
  role         String
  avatar       String
  bio          String
  experience   Int
  rating       Float                 @default(0)
  reviewCount  Int                   @default(0)
  available    Boolean               @default(true)
  isActive     Boolean               @default(true)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  bookings     Booking[]
  invoices     PayrollInvoice[]
  reviews      Review[]
  availability StylistAvailability[]
  payRate      StylistPayRate?
  slots        StylistSlot[]
  specialties  StylistSpecialty[]

  @@map("stylists")
}

model StylistSpecialty {
  id        String  @id @default(cuid())
  stylistId String
  name      String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@map("stylist_specialties")
}

model StylistSlot {
  id        String  @id @default(cuid())
  stylistId String
  time      String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@map("stylist_slots")
}

model StylistAvailability {
  id        String  @id @default(cuid())
  stylistId String
  dayOfWeek Int
  isWorking Boolean @default(true)
  startTime String
  endTime   String
  stylist   Stylist @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@unique([stylistId, dayOfWeek])
  @@map("stylist_availability")
}

model Client {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  phone       String
  notes       String?
  totalVisits Int       @default(0)
  totalSpent  Int       @default(0)
  lastVisit   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bookings    Booking[]

  @@map("clients")
}

model Booking {
  id            String        @id @default(cuid())
  customerName  String
  customerEmail String
  customerPhone String
  serviceId     String
  stylistId     String
  clientId      String?
  userId        String?
  date          DateTime
  time          String
  duration      Int
  price         Int
  notes         String?
  status        BookingStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        Client?       @relation(fields: [clientId], references: [id])
  service       Service       @relation(fields: [serviceId], references: [id])
  stylist       Stylist       @relation(fields: [stylistId], references: [id])
  user          User?         @relation(fields: [userId], references: [id])

  @@map("bookings")
}

model Review {
  id           String   @id @default(cuid())
  customerName String
  comment      String
  rating       Int
  serviceName  String
  userId       String?
  stylistId    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  stylist      Stylist? @relation(fields: [stylistId], references: [id])
  user         User?    @relation(fields: [userId], references: [id])

  @@map("reviews")
}

model GalleryImage {
  id        String          @id @default(cuid())
  src       String
  caption   String?
  category  ServiceCategory
  sortOrder Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now())

  @@map("gallery_images")
}

model SalonSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("salon_settings")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String?
  roomId    String?
  email     String?
  role      String   @default("client")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("push_subscriptions")
}

model ChatMessage {
  id         String   @id @default(cuid())
  roomId     String
  sender     String
  senderName String   @default("User")
  text       String
  createdAt  DateTime @default(now())

  @@index([roomId])
  @@map("chat_messages")
}

model StylistPayRate {
  id            String   @id @default(cuid())
  stylistId     String   @unique
  rateType      String   @default("COMMISSION")
  flatAmount    Int?
  commissionPct Float?
  baseSalary    Int?
  updatedAt     DateTime @updatedAt
  stylist       Stylist  @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@map("stylist_pay_rates")
}

model PayrollInvoice {
  id          String               @id @default(cuid())
  stylistId   String
  periodStart DateTime
  periodEnd   DateTime
  totalAmount Int                  @default(0)
  status      PaymentStatus        @default(PENDING)
  notes       String?
  paidAt      DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  items       PayrollInvoiceItem[]
  stylist     Stylist              @relation(fields: [stylistId], references: [id], onDelete: Cascade)

  @@map("payroll_invoices")
}

model PayrollInvoiceItem {
  id          String         @id @default(cuid())
  invoiceId   String
  bookingId   String?
  description String
  amount      Int
  date        DateTime
  invoice     PayrollInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payroll_invoice_items")
}

enum UserRole {
  ADMIN
  CLIENT
}

enum ServiceCategory {
  HAIRCUT
  BEARD
  COLOR
  FACIAL
  MASSAGE
  NAILS
  BRIDAL
  WAXING
  KERATIN
}

enum Gender {
  MALE
  FEMALE
  UNISEX
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
}
